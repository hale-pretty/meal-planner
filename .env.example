# Copy to .env (ignored by Git); generate secrets using the backend README command.
# Use the backend README setup command to generate passwords directly into .env.
# Do not commit real passwords or paste them into terminal/chat logs.
POSTGRES_DB=meal_planner
# Docker bootstrap administrator only; never supply its password to the backend.
POSTGRES_USER=meal_planner_owner
POSTGRES_PASSWORD=
# The backend uses only this password, for both Flyway and normal queries.
APP_DB_PASSWORD=
POSTGRES_PORT=5432
# Compose and ./gradlew bootRun read this file automatically.
# bootRun passes only the application password and database URL to Spring Boot.
# Optional DATABASE_URL overrides the URL derived from POSTGRES_DB/POSTGRES_PORT.
# Values are literal KEY=value, optionally quoted; shell expansion is not supported.
